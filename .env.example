# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL + Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/civibridge?schema=public

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Admin provisioning secret (change in production)
ADMIN_PROVISION_SECRET=change_me_securely

# Note: embeddings are stored in PostgreSQL in the `grievanceCategory.embedding` column.
